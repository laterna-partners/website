# Resend, for the contact form, take-home note signup and Hayri's
# notification emails. Get from https://resend.com
RESEND_API_KEY=re_xxx

# Email destination, submissions land here
NOTIFY_EMAIL=hayri@laterna.partners

# Verified sender (must match a domain you've verified in Resend)
FROM_EMAIL="Laterna+Partners <noreply@laterna.partners>"

# Supabase, for QR scan, click and form submission persistence, and the
# site-hints lookup. Uses the anon (publishable) key: RLS on every table
# restricts it to INSERT-only, except site_hints which allows SELECT too.
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=eyJxxx

# Signs the anti-bot form token (GET /api/form-token) and the signed PDF
# download link (GET /api/note/[token]). Any long random string. If unset,
# both checks fail open (skipped, logged as an error) rather than blocking
# submissions, so set this before relying on it in production.
FORM_SIGNING_SECRET=change-me

# Cloudflare Turnstile, bot protection for the two landowners-page forms.
# Get both from https://dash.cloudflare.com/?to=/:account/turnstile
# Public, build-time: the site key rendered into the widget. If unset, no
# widget is shown and the form still submits (the server decides).
PUBLIC_TURNSTILE_SITE_KEY=0x4xxx

# Secret, runtime only: verifies the widget response server-side. If unset,
# Turnstile verification is skipped (logged as an error) rather than blocking
# submissions, so set this before relying on it in production.
TURNSTILE_SECRET_KEY=0x4xxx

# Attio CRM sync (src/lib/attio.ts). Optional: if unset, CRM mirroring is
# skipped (logged once as a warning) and everything else works as normal.
# Scope the key to only the objects this integration touches, not full access.
ATTIO_API_KEY=xxx

# Note-signup PDF attachment switch. Unset (or any value other than "1"):
# the requester email carries a signed downloadUrl link instead of the file.
# Set to 1 to attach the PDF directly again, until the Resend template body
# is edited in the dashboard to use {{downloadUrl}}.
NOTE_ATTACH_PDF=0
