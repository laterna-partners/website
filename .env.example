# Resend — for contact form + take-home note signup
# Get from https://resend.com (free tier covers this volume)
RESEND_API_KEY=re_xxx

# Email destination — submissions land here
NOTIFY_EMAIL=hayri@laterna.partners

# Verified sender (must match a domain you've verified in Resend)
FROM_EMAIL="Laterna+Partners <noreply@laterna.partners>"

# Supabase — for QR scan + form submission persistence
PUBLIC_SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# Optional — if you want to map known refs to a site-hint string shown in the Hero
# (e.g. "the two-acre paddock east of Pilgrims Lane")
# This will eventually live in Supabase, but during early days an env var is fine.
