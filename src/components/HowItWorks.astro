---
// How it works: five rows, each with its sketch, its sentence, and the two
// things a landowner actually wants to know (how long, what it costs).
const STEPS = [
  {
    title: 'A conversation',
    body: 'We talk on the phone or on WhatsApp about your site and what you would like to understand.',
    time: '10 to 20 minutes.',
    cost: 'Nothing. It is just a conversation.',
    sketch: 'step-1-conversation',
    alt: 'A hand holding a telephone in conversation, an open letter beside it.',
    width: 958,
    height: 718,
  },
  {
    title: 'Appraisal and visit',
    body: 'I research the planning history and local policy for your site, then visit in person if it looks promising.',
    time: '2 to 4 weeks.',
    cost: 'Nothing. I cover my own time and travel.',
    sketch: 'step-2-appraisal',
    alt: 'The site pinned within its street and neighbourhood, seen from above.',
    width: 952,
    height: 714,
  },
  {
    title: 'Offer and agreement',
    body: 'I put a fixed price to you in writing, and solicitors draw up the option agreement between us: a right to buy later, at the price fixed now.',
    time: '4 to 8 weeks.',
    cost: 'Nothing, including your own solicitor’s reasonable fees, which I pay.',
    sketch: 'step-3-offer',
    alt: 'An architect’s desk with a model, drawings and a pen resting on a signed sheet.',
    width: 958,
    height: 718,
  },
  {
    title: 'Planning',
    body: 'I submit and manage the planning application. The cost of it is carried on my side.',
    time: '12 to 24 months.',
    cost: 'Nothing. The planning costs are never yours.',
    sketch: 'step-4-planning',
    alt: 'The site read in layers, from boundary to buildings above.',
    width: 954,
    height: 716,
  },
  {
    title: 'Completion or lapse',
    body: 'If consent is granted, I buy the land at the agreed price. If it is refused, the option lapses.',
    time: '4 to 8 weeks after the decision.',
    cost: 'Nothing, whichever way it goes.',
    sketch: 'step-5-completion',
    alt: 'Three finished homes shown beside their plans.',
    width: 814,
    height: 610,
  },
];
---
<section id="how" class="lp-section">
  <div class="lp-shell">
    <div class="how-body">
      <div class="how-rail">
        <p class="lp-eyebrow">How it works</p>
      </div>

      <div class="how-main">
        <h2 class="lp-h2 how-head">Five steps.</h2>

        <ol class="how-list" data-reveal-group>
          {STEPS.map((step, index) => (
            <li class="how-step" data-reveal>
              <div class="how-art">
                <img
                  class="lp-sketch"
                  src={`/assets/sketches/${step.sketch}.webp`}
                  alt={step.alt}
                  width={step.width}
                  height={step.height}
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="how-text">
                <p class="how-number"><span class="how-number-word">Step </span>{index + 1}</p>
                <h3 class="how-title">{step.title}</h3>
                <p class="how-sentence">{step.body}</p>
              </div>

              <dl class="how-facts">
                <div class="how-fact">
                  <dt>Typical time</dt>
                  <dd>{step.time}</dd>
                </div>
                <div class="how-fact">
                  <dt>What it costs you</dt>
                  <dd>{step.cost}</dd>
                </div>
              </dl>
            </li>
          ))}
        </ol>

        <div class="how-close">
          <p>
            If I do not think your site is suitable, I will tell you honestly, rather than string
            things along.
          </p>
          <p>
            Planning takes 12 to 24 months. Nothing is asked of you in that time, and you use the
            land exactly as you do now.
          </p>
          <p class="lp-h3 how-signature">I cover the work. You keep the land. You decide.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .how-body {
    padding: 64px 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .how-main {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .how-head {
    margin: 0;
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--lp-ink-display);
    text-wrap: balance;
  }

  .how-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  /* Mobile: sketch on top, a hairline under it, then the words. */
  .how-step {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .how-art {
    width: 100%;
    aspect-ratio: 4 / 3;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--lp-rule);
  }
  .how-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .how-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .how-number {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--lp-mute-text);
    font-variant-numeric: tabular-nums;
  }
  .how-title {
    margin: 0;
    font-size: 22px;
    font-weight: 400;
    line-height: 1.25;
    color: var(--lp-ink-display);
  }
  .how-sentence {
    margin: 0;
    max-width: 46ch;
  }

  .how-facts {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .how-fact {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .how-fact dt {
    font-size: 15px;
    font-weight: 600;
    color: var(--lp-ink-display);
  }
  .how-fact dd {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--lp-mute-text);
  }

  .how-close {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 62ch;
  }
  .how-close p {
    margin: 0;
  }
  .how-signature {
    margin: 8px 0 0;
    font-weight: 300;
    color: var(--lp-ink-display);
    text-wrap: balance;
  }

  @media (min-width: 720px) {
    .how-body {
      padding: 96px 0;
    }
  }

  /* Desktop: one full-width row per step. */
  @media (min-width: 1024px) {
    .how-body {
      padding: 128px 0;
      display: grid;
      grid-template-columns: 200px minmax(0, 1fr);
      column-gap: 32px;
      align-items: start;
    }
    .how-main {
      gap: 64px;
    }
    .how-list {
      gap: 0;
    }
    .how-step {
      display: grid;
      grid-template-columns: 240px minmax(0, 1fr) 260px;
      column-gap: 32px;
      align-items: start;
      padding: 32px 0;
      border-top: 1px solid var(--lp-rule);
    }
    .how-step:last-child {
      border-bottom: 1px solid var(--lp-rule);
    }
    .how-art {
      width: 240px;
      padding-bottom: 0;
      border-bottom: 0;
    }
    .how-number-word {
      display: none;
    }
  }
</style>
