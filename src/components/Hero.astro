---
// Hero. Renders one of three arrival states:
//   cold           no ref at all
//   letter-known   a ref and a site hint we recognise
//   letter-unknown a ref we will check by hand
interface Props {
  ref?: string | null;
  siteHint?: string | null;
}
const { ref = null, siteHint = null } = Astro.props;

const isLetter = Boolean(ref);
const hint = siteHint ? siteHint.trim().replace(/\.$/, '') : null;

const headline = !isLetter
  ? 'A fixed-price offer for your land, subject to planning.'
  : hint
    ? `I wrote to you about ${hint}.`
    : 'I wrote to you about your land.';

const subLede = isLetter
  ? 'This page is here because you scanned the QR code on my letter. It is the same explanation I would give over the phone, set down so you can read it in your own time.'
  : 'This is the same explanation I would give over the phone, set down in one place so you can read it in your own time.';
---
<section class="hero" data-hero>
  <div class="lp-shell">
    <div class="hero-grid">
      <div class="hero-rail">
        {isLetter && <p class="hero-badge">Letter {ref}</p>}
        <p class="lp-eyebrow">For landowners</p>
        {isLetter && !hint && (
          <p class="lp-small hero-rail-note">
            I will check reference {ref} personally when you get in touch.
          </p>
        )}
        {!isLetter && <p class="lp-small hero-rail-line">Across the United Kingdom.</p>}
      </div>

      <h1 class="lp-h1 hero-head">{headline}</h1>

      <div class="hero-body">
        <p class="lp-lede hero-lede">
          I pay for the planning work and take the risk that goes with it. The price is fixed in
          writing before you agree to anything, and you are free to say no.
        </p>

        <p class="hero-sub-lede">{subLede}</p>

        <div class="hero-actions" data-hero-actions>
          <div class="hero-buttons">
            <a class="lp-btn lp-btn-primary hero-call-link" href="tel:+447471127212" data-click="call">Call Hayri</a>
            <button
              type="button"
              class="lp-btn lp-btn-primary hero-call-btn"
              data-phone-reveal="hero"
              data-click="call"
            >
              <span>Call Hayri</span>
              <span class="ph-num" hidden>+44 7471 127212</span>
            </button>
            <a
              class="lp-btn lp-btn-secondary"
              href="https://wa.me/447471127212"
              data-click="whatsapp"
              target="_blank"
              rel="noopener"
            >WhatsApp</a>
          </div>
          <span class="ph-status lp-small" role="status" aria-live="polite"></span>
          <a class="lp-btn-link hero-message-link" href="#contact">Send a message instead</a>
        </div>

        <p class="lp-small hero-microline">
          Weekdays 09:00 to 18:00. Leave a message and I will call you back within one working day.
        </p>
      </div>

      <figure class="hero-art">
        <div class="hero-layers" data-letter={isLetter ? 'true' : null}>
          <img
            class="hero-layer hero-layer-grey"
            src="/assets/sketches/hero-street-grey.webp"
            alt=""
            width="936"
            height="702"
            fetchpriority="high"
            decoding="async"
          />
          <img
            class="hero-layer hero-layer-blue"
            src="/assets/sketches/hero-street-blue.webp"
            alt="A street of terraced houses seen from above; behind them, on a garden plot, one new home is picked out in blue."
            width="936"
            height="702"
            fetchpriority="high"
            decoding="async"
          />
          {isLetter && <span class="hero-plot-label" aria-hidden="true">{ref}</span>}
        </div>
        <figcaption class="lp-caption hero-caption">
          An ordinary street, with one plot worth a second look.
        </figcaption>
      </figure>

      <div class="hero-sig">
        <div class="hero-sig-text">
          <p class="hero-sig-name">Hayri Demirçapa</p>
          <p class="lp-small hero-sig-role">Founder &amp; Architect, Laterna+Partners</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { copyText } from '../scripts/ui';

  const PHONE = '+44 7471 127212';

  document
    .querySelectorAll<HTMLButtonElement>('[data-phone-reveal="hero"]')
    .forEach((button) => {
      const number = button.querySelector<HTMLElement>('.ph-num');
      const actions = button.closest('[data-hero-actions]');
      const status = actions?.querySelector<HTMLElement>('.ph-status') ?? null;
      let timer = 0;

      button.addEventListener('click', async () => {
        if (number) number.hidden = false;
        const copied = await copyText(PHONE);
        if (!status) return;
        status.textContent = copied === false ? '' : 'Copied';
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          status.textContent = '';
        }, 4000);
      });
    });
</script>

<style>
  .hero {
    padding: 40px 0 56px;
  }

  .hero-grid {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* ---- rail ------------------------------------------------------------- */
  .hero-rail {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }
  .hero-badge {
    margin: 0;
    width: 100%;
    box-sizing: border-box;
    min-height: 36px;
    display: flex;
    align-items: center;
    padding: 6px 16px;
    border: 1px solid var(--lp-rule);
    border-radius: 999px;
    background: var(--lp-paper-soft);
    color: var(--lp-ink-display);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }
  .hero-rail-note,
  .hero-rail-line {
    margin: 0;
    max-width: 30ch;
  }

  /* ---- headline and copy ------------------------------------------------ */
  .hero-head {
    margin: 0;
    font-size: clamp(40px, 5.6vw, 80px);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--lp-ink-display);
    max-width: 20ch;
    text-wrap: balance;
  }

  .hero-body {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .hero-lede {
    margin: 0;
    max-width: 48ch;
  }
  .hero-sub-lede {
    margin: 0;
    max-width: 52ch;
  }

  /* ---- actions ---------------------------------------------------------- */
  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: stretch;
  }
  .hero-buttons {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .hero-buttons > * {
    width: 100%;
    box-sizing: border-box;
  }
  .hero-call-btn {
    display: none;
  }
  .ph-num {
    font-variant-numeric: tabular-nums;
  }
  .ph-status:empty {
    display: none;
  }
  .hero-message-link {
    align-self: flex-start;
  }
  .hero-microline {
    margin: 0;
    max-width: 46ch;
  }

  /* ---- drawing ---------------------------------------------------------- */
  .hero-art {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .hero-layers {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
  }
  .hero-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
  }
  .hero-layer-grey {
    animation: hero-fade 600ms var(--lp-ease, ease) 200ms forwards;
  }
  .hero-layer-blue {
    animation: hero-fade 400ms var(--lp-ease, ease) 1400ms forwards;
  }
  .hero-plot-label {
    position: absolute;
    left: 39.1%;
    top: 40%;
    transform: translate(-50%, -100%);
    margin-top: -14px;
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 0 10px;
    background: var(--lp-paper-soft);
    border: 1px solid var(--lp-rule);
    color: var(--lp-ink-display);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    opacity: 0;
    animation: hero-fade 180ms var(--lp-ease, ease) 1900ms forwards;
  }
  .hero-caption {
    margin: 0;
  }

  @keyframes hero-fade {
    to {
      opacity: 1;
    }
  }

  /* ---- signature -------------------------------------------------------- */
  .hero-sig {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }
  .hero-sig-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .hero-sig-name {
    margin: 0;
    font-size: 18px;
    font-weight: 500;
    color: var(--lp-ink-display);
  }
  .hero-sig-role {
    margin: 0;
    max-width: 38ch;
  }

  /* ---- 720 and up ------------------------------------------------------- */
  @media (min-width: 720px) {
    .hero {
      padding: 72px 0 96px;
    }
    .hero-badge {
      width: auto;
    }
    .hero-buttons {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px;
    }
    .hero-buttons > * {
      width: auto;
    }
    .hero-call-link {
      display: none;
    }
    .hero-call-btn {
      display: inline-flex;
    }
    .hero-actions {
      align-items: flex-start;
    }
    /* Between phone and desktop the drawing would otherwise run the full
       width of the page, which dwarfs the words beside it. */
    .hero-art {
      max-width: 528px;
    }
  }

  /* ---- 1024 and up: the Desktop A three-column arrangement -------------- */
  @media (min-width: 1024px) {
    .hero {
      padding: 96px 0 128px;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 200px minmax(0, 7fr) minmax(0, 9fr);
      grid-template-areas:
        'rail head head'
        'rail body art'
        'rail sig  art';
      column-gap: 32px;
      row-gap: 32px;
      align-items: start;
    }
    .hero-rail {
      grid-area: rail;
    }
    .hero-head {
      grid-area: head;
    }
    .hero-body {
      grid-area: body;
    }
    .hero-art {
      grid-area: art;
      gap: 16px;
    }
    .hero-sig {
      grid-area: sig;
      align-self: start;
    }
    .hero-lede {
      max-width: none;
    }
    .hero-sub-lede {
      max-width: none;
    }
  }

  /* ---- reduced motion: show the finished drawing ------------------------ */
  @media (prefers-reduced-motion: reduce) {
    .hero-layer,
    .hero-plot-label {
      animation: none;
      opacity: 1;
    }
  }
</style>
