---
import PrivacyPanel from './PrivacyPanel.astro';
---
<footer class="site-footer">
  <div class="lp-shell footer-top">
    <div class="footer-cols">
      <div class="footer-col">
        <img
          class="footer-mark"
          src="/assets/laterna-logo-full.png"
          alt="Laterna+Partners"
          width="120"
          height="49"
          loading="lazy"
        />
        <p class="footer-line">
          A small practice in South West London, helping landowners explore the planning value of
          their sites.
        </p>
      </div>

      <div class="footer-col">
        <p class="footer-line">Laterna Partners Ltd, South West London</p>
      </div>

      <div class="footer-col">
        <a class="footer-link" href="tel:+447471127212" data-click="call">
          +44 7471 127212 (call or WhatsApp)
        </a>
        <a class="footer-link" href="mailto:hayri@laterna.partners" data-click="email">
          hayri@laterna.partners
        </a>
        <a
          class="footer-link"
          href="https://www.linkedin.com/company/laterna-partners"
          target="_blank"
          rel="noopener"
        >LinkedIn</a>
      </div>

      <div class="footer-col">
        <PrivacyPanel />
      </div>
    </div>

    <div class="footer-notes">
      <p class="footer-disclaimer">
        Information on this page is general guidance, not planning, legal, financial or valuation
        advice. Any offer is subject to contract and to the terms of a written option agreement.
      </p>
      <p class="footer-disclaimer">This page sets no cookies and uses no trackers.</p>
    </div>
  </div>

  <div class="legal-bar">
    <div class="lp-shell">
      <p class="legal-text">
        Laterna Partners Ltd, registered in England and Wales, company number 11017779.
        Registered office: 7 Daffodil Close, Mitcham CR4 4FS.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--lp-rule); }
  .footer-top { padding: 48px 0 32px; }

  .footer-cols { display: flex; flex-direction: column; gap: 32px; }
  .footer-col { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .footer-mark { width: 120px; height: auto; margin-bottom: 8px; }

  .footer-line {
    font-size: 15px;
    line-height: 1.55;
    color: var(--lp-mute-text);
    margin: 0;
    max-width: 40ch;
  }
  .footer-link {
    font-size: 15px;
    line-height: 1.55;
    color: var(--lp-ink);
    padding: 12px 0;
    display: inline-block;
  }

  .footer-notes { display: flex; flex-direction: column; gap: 12px; margin-top: 40px; }
  .footer-disclaimer {
    font-size: 15px;
    line-height: 1.6;
    color: var(--lp-mute-text);
    margin: 0;
    max-width: 78ch;
  }

  .legal-bar { border-top: 1px solid var(--lp-rule); padding: 24px 0; }
  .legal-text {
    font-size: 13px;
    line-height: 1.5;
    color: var(--lp-mute-text);
    margin: 0;
  }

  @media (min-width: 720px) {
    .footer-top { padding: 64px 0 40px; }
    .footer-cols {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px 32px;
    }
  }

  @media (min-width: 1024px) {
    .footer-cols { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
