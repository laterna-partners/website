---
// Get in touch: the three channels, then the one merged form. The
// "Something to read later" block (TakeHomeNote) is slotted in below the
// form so it sits inside this same section, as in the V2 artboards.
interface Props { ref?: string | null }
const { ref = null } = Astro.props;
const siteLabel = ref
  ? 'Site reference, from your letter'
  : 'Site reference, if you have one';
---
<section id="contact" class="contact">
  <div class="lp-shell">
    <div class="sec-grid">
      <div class="sec-rail">
        <p class="lp-eyebrow">Get in touch</p>
      </div>

      <div class="sec-body">
        <div class="contact-intro">
          <h2 class="lp-h2">A short, no-commitment phone call is the best place to start.</h2>
          <p class="lp-lede">
            Ten minutes is usually enough. If you would rather write than call, use the form and
            I will come back to you within one working day. There is no script and no pressure,
            just a conversation about your site.
          </p>
        </div>

        <div class="channels" data-reveal>
          <a class="channel" href="tel:+447471127212" data-click="call">
            <span class="channel-label">Call</span>
            <span class="channel-value">+44 7471 127212, weekdays 09:00 to 18:00</span>
          </a>
          <a
            class="channel"
            href="https://wa.me/447471127212"
            target="_blank"
            rel="noopener"
            data-click="whatsapp"
          >
            <span class="channel-label">WhatsApp</span>
            <span class="channel-value">+44 7471 127212, message any time</span>
          </a>
          <a class="channel" href="mailto:hayri@laterna.partners" data-click="email">
            <span class="channel-label">Email</span>
            <span class="channel-value">hayri@laterna.partners</span>
          </a>
        </div>

        <div class="form-slot">
          <form id="contact-form" class="contact-form" method="POST" action="/api/contact" novalidate>
            <div class="field-pair">
              <div class="lp-field">
                <label class="lp-label" for="contact-name">
                  Your name <span class="req" aria-hidden="true">*</span>
                </label>
                <input
                  class="lp-input"
                  id="contact-name"
                  name="name"
                  type="text"
                  placeholder="Jane Smith"
                  autocomplete="name"
                  required
                />
                <p class="lp-error" id="contact-name-error" hidden></p>
              </div>

              <div class="lp-field">
                <label class="lp-label" for="contact-reach">
                  How can I reach you? <span class="req" aria-hidden="true">*</span>
                </label>
                <input
                  class="lp-input"
                  id="contact-reach"
                  name="reach"
                  type="text"
                  placeholder="Phone number or email address"
                  autocomplete="on"
                  required
                />
                <p class="lp-error" id="contact-reach-error" hidden></p>
              </div>
            </div>

            <div class="lp-field">
              <label class="lp-label" for="contact-site">{siteLabel}</label>
              <input
                class="lp-input"
                id="contact-site"
                name="site"
                type="text"
                placeholder="e.g. SITE-26-0418"
                value={ref ?? ''}
              />
            </div>

            <div class="lp-field">
              <label class="lp-label" for="contact-message">Anything you would like to say</label>
              <textarea
                class="lp-textarea"
                id="contact-message"
                name="message"
                rows="4"
                placeholder="Tell me a little about your site, or ask a question."
              ></textarea>
            </div>

            <div class="check-row">
              <input class="lp-checkbox" id="contact-note" name="note" type="checkbox" />
              <label for="contact-note">Also email me the note on option agreements</label>
            </div>

            <input
              class="honeypot"
              type="text"
              name="company"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />
            <input type="hidden" name="form_type" value="contact" />
            <input type="hidden" name="form_token" value="" />

            <div class="turnstile-wrap">
              <div id="turnstile-contact" class="lp-turnstile"></div>
              <p class="lp-caption">Checked for spam by Cloudflare. No cookies.</p>
            </div>

            <div class="submit-row">
              <button type="submit" class="lp-btn lp-btn-primary">Send</button>
              <p class="lp-error form-fail" id="contact-fail" hidden>
                Sorry, that could not be sent. Please email
                <a href="mailto:hayri@laterna.partners" data-click="email">hayri@laterna.partners</a>
                or call.
              </p>
              <p class="lp-caption">
                Goes only to me. No mailing list, no sharing, no tracking.
                <a class="privacy-link" href="#privacy">Privacy and how I use your data</a>
              </p>
            </div>
          </form>

          <div id="contact-success" class="success" role="status" hidden>
            <svg class="tick" width="32" height="32" viewBox="0 0 64 64" role="img" aria-label="Sent" focusable="false">
              <path d="M9.5 31.5L25.09 40.5L54.53 23.5" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" pathLength="1"></path>
            </svg>
            <h3 class="lp-h3">Thank you.</h3>
            <p class="success-body">
              Your message has come straight to me, and I will reply within one working day.
            </p>
            <p class="success-note" id="contact-success-note" hidden>
              The note on option agreements is on its way to your inbox.
            </p>
          </div>
        </div>

        <slot />
      </div>
    </div>
  </div>
</section>

<script>
  import { fillFormToken, postForm, renderTurnstile, resetTurnstile } from '../lib/form-client';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const success = document.getElementById('contact-success');
  const successNote = document.getElementById('contact-success-note');
  const fail = document.getElementById('contact-fail');
  const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
  const reachInput = document.getElementById('contact-reach') as HTMLInputElement | null;
  const noteBox = document.getElementById('contact-note') as HTMLInputElement | null;
  const nameError = document.getElementById('contact-name-error');
  const reachError = document.getElementById('contact-reach-error');

  const GENERIC = 'Sorry, that could not be sent. Please email hayri@laterna.partners or call.';

  function setFieldError(input: HTMLInputElement | null, box: HTMLElement | null, message: string) {
    if (!input || !box) return;
    box.textContent = message;
    box.hidden = false;
    input.setAttribute('aria-invalid', 'true');
    input.setAttribute('aria-describedby', box.id);
  }

  function clearFieldError(input: HTMLInputElement | null, box: HTMLElement | null) {
    if (!input || !box) return;
    box.textContent = '';
    box.hidden = true;
    input.removeAttribute('aria-invalid');
    input.removeAttribute('aria-describedby');
  }

  function clearAll() {
    clearFieldError(nameInput, nameError);
    clearFieldError(reachInput, reachError);
    if (fail) fail.hidden = true;
  }

  function showFailure(message?: string) {
    if (!fail) return;
    if (message) fail.textContent = message;
    fail.hidden = false;
  }

  // Server error codes mapped onto the field they belong to.
  function applyServerError(code: string | undefined) {
    switch (code) {
      case 'invalid_name':
        setFieldError(nameInput, nameError, 'Please add your name so I know who I am replying to.');
        nameInput?.focus();
        return;
      case 'invalid_contact':
      case 'invalid_email':
        setFieldError(reachInput, reachError, 'Please check that phone number or email address.');
        reachInput?.focus();
        return;
      case 'note_needs_email':
        setFieldError(
          reachInput,
          reachError,
          'Add an email address and I will send the note, or untick the box.',
        );
        reachInput?.focus();
        return;
      case 'bad_token':
      case 'verification_failed':
      case 'bad_origin':
        showFailure('That could not be checked for spam. Please try again, or call instead.');
        return;
      case 'rate_limited':
        showFailure('That is several messages in a short time. Please try again shortly, or call.');
        return;
      default:
        showFailure(GENERIC);
    }
  }

  if (form) {
    fillFormToken(form);
    renderTurnstile('turnstile-contact', import.meta.env.PUBLIC_TURNSTILE_SITE_KEY);

    nameInput?.addEventListener('input', () => clearFieldError(nameInput, nameError));
    reachInput?.addEventListener('input', () => clearFieldError(reachInput, reachError));

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearAll();

      const name = nameInput?.value.trim() ?? '';
      const reach = reachInput?.value.trim() ?? '';

      if (!name) {
        setFieldError(nameInput, nameError, 'Please add your name so I know who I am replying to.');
        nameInput?.focus();
        return;
      }
      if (!reach) {
        setFieldError(reachInput, reachError, 'Please add a phone number or an email address.');
        reachInput?.focus();
        return;
      }
      if (noteBox?.checked && !reach.includes('@')) {
        setFieldError(
          reachInput,
          reachError,
          'Add an email address and I will send the note, or untick the box.',
        );
        reachInput?.focus();
        return;
      }

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const label = button?.textContent ?? 'Send';
      if (button) {
        button.disabled = true;
        button.textContent = 'Sending...';
      }

      const tokenInput = form.querySelector<HTMLInputElement>('input[name="form_token"]');
      if (tokenInput && !tokenInput.value) await fillFormToken(form);

      try {
        const { body: result } = await postForm(form);
        if (result && result.ok) {
          if (successNote) successNote.hidden = !(result as { note_requested?: boolean }).note_requested;
          // Hold the space the form occupied so nothing below it moves.
          const slot = form.closest('.form-slot') as HTMLElement | null;
          if (slot) slot.style.minHeight = `${Math.round(slot.getBoundingClientRect().height)}px`;
          form.hidden = true;
          success?.removeAttribute('hidden');
          return;
        }
        applyServerError(result?.error);
      } catch {
        showFailure(GENERIC);
      }

      if (button) {
        button.disabled = false;
        button.textContent = label;
      }
      resetTurnstile('turnstile-contact');
      await fillFormToken(form);
    });
  }
</script>

<style>
  .contact {
    padding: 64px 0;
    border-top: 1px solid var(--lp-rule);
  }

  .sec-grid { display: flex; flex-direction: column; gap: 24px; }
  .sec-body { display: flex; flex-direction: column; gap: 48px; min-width: 0; }
  .contact-intro { display: flex; flex-direction: column; gap: 16px; max-width: 62ch; }

  .channels { display: flex; flex-direction: column; }
  .channel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    min-height: 64px;
    padding: 12px 0;
    border-bottom: 1px solid var(--lp-rule);
    text-decoration: none;
  }
  .channel:first-child { border-top: 1px solid var(--lp-rule); }
  .channel-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lp-ink-display);
    margin-right: -0.18em;
  }
  .channel-value {
    font-size: 19px;
    font-weight: 300;
    line-height: 1.3;
    color: var(--lp-ink-display);
  }

  /* The form's height is measured and reserved on the slot at submit time,
     so swapping in the success panel moves nothing below it. */
  .contact-form { display: flex; flex-direction: column; gap: 24px; max-width: 62ch; }
  .contact-form[hidden] { display: none; }
  .field-pair { display: flex; flex-direction: column; gap: 24px; }

  .req { color: var(--lp-ink-display); }

  .check-row { display: flex; align-items: center; gap: 12px; min-height: 44px; }
  .check-row label { font-size: 17px; line-height: 1.5; color: var(--lp-ink); }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .turnstile-wrap { display: flex; flex-direction: column; gap: 8px; }
  /* Reserve the widget's height so nothing jumps when it renders. */
  .lp-turnstile { min-height: 65px; width: 100%; }
  .lp-turnstile :global(iframe) { max-width: 100%; }

  .submit-row { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .form-fail[hidden] { display: none; }
  .privacy-link { display: inline-block; padding: 12px 0; }

  .success {
    background: var(--lp-paper-soft);
    padding: 40px 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    max-width: 62ch;
  }
  .success[hidden] { display: none; }
  .tick { color: var(--lp-ink); }
  .tick path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: tick-draw 400ms cubic-bezier(0.2, 0.6, 0.2, 1) 120ms forwards;
  }
  @keyframes tick-draw { to { stroke-dashoffset: 0; } }
  .success-body { font-size: 17px; line-height: 1.7; color: var(--lp-ink); margin: 0; max-width: 48ch; }
  .success-note { font-size: 15px; line-height: 1.55; color: var(--lp-mute-text); margin: 0; max-width: 48ch; }
  .success-note[hidden] { display: none; }

  @media (min-width: 720px) {
    .contact { padding: 96px 0; }
    .channel-value { font-size: 22px; }
    .check-row label { font-size: 18px; }
    .success { padding: 48px; }
  }

  @media (min-width: 1024px) {
    .contact { padding: 128px 0; border-top: 0; }
    .sec-grid { flex-direction: row; align-items: flex-start; gap: 32px; }
    .sec-rail { flex: 0 0 200px; }
    .sec-body { flex: 1 1 auto; }
    .channel {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }
    .contact-form { gap: 32px; }
    .field-pair { flex-direction: row; gap: 24px; }
    .field-pair > .lp-field { flex: 1 1 0; min-width: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tick path { animation: none; stroke-dashoffset: 0; }
  }
</style>
