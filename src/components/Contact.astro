---
import Section from './Section.astro';
import Marginalia from './Marginalia.astro';
import Label from './Label.astro';
interface Props { showForm?: boolean; }
const { showForm = true } = Astro.props;
---
<Section id="contact" style="padding-top: 96px; padding-bottom: 96px;">
  <Marginalia label="Get in touch" sub="In your own time, in your own way.">
    <div class="contact-wrap">
      <h2 class="contact-head">
        A short, no-commitment phone call is the best place to start.
      </h2>
      <p class="contact-lede">
        Ten minutes is usually enough. I will answer anything specific to your site, and you
        are under no obligation to take anything further.
      </p>

      <div class="channels">
        <div class="channel-row">
          <Label asTag="div">Phone</Label>
          <a href="tel:+447471127212" class="channel-link channel-link--primary">+44 7471 127212</a>
        </div>
        <div class="channel-row">
          <Label asTag="div">Email</Label>
          <a href="mailto:hayri@laterna.partners" class="channel-link">hayri@laterna.partners</a>
        </div>

        {showForm && (
          <div class="channel-row form-row">
            <Label asTag="div">Form</Label>
            <div>
              <button type="button" id="contact-form-open" class="form-toggle">
                Write something here instead <span class="arrow">→</span>
              </button>

              <form
                id="contact-form"
                method="POST"
                action="/api/contact"
                class="contact-form"
                hidden
              >
                <label class="field-label">
                  <span class="field-name">Your name *</span>
                  <input name="name" type="text" required placeholder="Jane Smith" autocomplete="name" />
                </label>
                <label class="field-label">
                  <span class="field-name">A way to reach you *</span>
                  <input name="contact" type="text" required placeholder="Phone or email" />
                </label>
                <div class="full-row">
                  <label class="field-label">
                    <span class="field-name">The site, if you know the reference</span>
                    <input name="site" type="text" placeholder="e.g. SITE-26-0418 (from the letter)" />
                  </label>
                </div>
                <div class="full-row">
                  <label class="field-label">
                    <span class="field-name">Anything you would like to say</span>
                    <textarea name="message" rows="4" placeholder="Optional. Even a sentence helps."></textarea>
                  </label>
                </div>
                <!-- honeypot -->
                <input type="text" name="company" class="honeypot" tabindex="-1" autocomplete="off" />
                <input type="hidden" name="form_type" value="contact" />

                <div class="full-row submit-row">
                  <button type="submit" class="lp-submit">Send</button>
                  <span class="lp-fine privacy-note">
                    Goes only to me. No mailing list, no sharing, no tracking.
                  </span>
                </div>
              </form>
            </div>
          </div>
        )}
      </div>

      <p class="lp-fine contact-fine">
        All enquiries are treated in strict confidence. There are no cookies on this page and
        no third-party trackers. If you have a moment to scroll to the top, the letter
        reference appears there.
      </p>
    </div>
  </Marginalia>
</Section>

<script>
  const open = document.getElementById('contact-form-open');
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  open?.addEventListener('click', () => {
    open.style.display = 'none';
    form?.removeAttribute('hidden');
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    if (btn) { btn.disabled = true; btn.textContent = 'Sending...'; }
    try {
      const res = await fetch('/api/contact', { method: 'POST', body: data });
      if (!res.ok) throw new Error('Failed');
      form.innerHTML = '<p class="contact-sent">Sent — thank you. I will be in touch within a working day.</p>';
    } catch (_err) {
      if (btn) { btn.disabled = false; btn.textContent = 'Try again'; }
      alert('Sorry — something went wrong. Please try again, or email hayri@laterna.partners.');
    }
  });
</script>

<style>
  .contact-wrap { max-width: 52rem; }
  .contact-head {
    font-size: clamp(30px, 4.4vw, 52px);
    line-height: 1.1;
    font-weight: 300;
    letter-spacing: -0.02em;
    color: var(--lp-ink-display);
    margin: 0;
    max-width: 20ch;
    text-wrap: balance;
  }
  .contact-lede {
    font-size: 17px;
    line-height: 1.7;
    color: var(--lp-ink);
    margin: 20px 0 0;
    max-width: 54ch;
  }
  .channels { margin-top: 48px; }
  .channel-row {
    display: grid;
    grid-template-columns: minmax(0, 96px) minmax(0, 1fr);
    gap: 24px;
    align-items: baseline;
    padding: 24px 0;
    border-top: 1px solid var(--lp-rule);
  }
  .form-row { border-bottom: 1px solid var(--lp-rule); }
  .channel-link {
    font-size: 19px;
    font-weight: 400;
    color: var(--lp-ink-display);
    text-decoration: none;
    letter-spacing: 0;
    border-bottom: 1px solid var(--lp-rule);
    padding-bottom: 2px;
    transition: opacity 180ms cubic-bezier(0.2, 0.6, 0.2, 1);
    display: inline-block;
    line-height: 1.15;
  }
  .channel-link--primary {
    font-size: clamp(28px, 4.6vw, 44px);
    font-weight: 300;
    letter-spacing: -0.005em;
    border-bottom-color: var(--lp-ink-display);
    padding-bottom: 4px;
  }
  .channel-link:hover { opacity: 0.6; }

  .form-toggle {
    appearance: none;
    background: transparent;
    border: 0;
    padding: 0;
    font-family: var(--lp-sans);
    font-size: 19px;
    color: var(--lp-ink-display);
    cursor: pointer;
    border-bottom: 1px solid var(--lp-rule);
    padding-bottom: 2px;
    letter-spacing: 0.005em;
    transition: border-color 180ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .form-toggle:hover { border-bottom-color: var(--lp-ink-display); }
  .arrow { margin-left: 6px; }

  .contact-form {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 32px 40px;
    margin-top: 32px;
    max-width: 720px;
  }
  .full-row { grid-column: 1 / -1; }
  .field-label { display: flex; flex-direction: column; gap: 10px; }
  .field-name {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--lp-mute);
    margin-right: -0.18em;
  }
  .field-label input,
  .field-label textarea {
    appearance: none;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--lp-rule);
    border-radius: 0;
    padding: 10px 0;
    font: inherit;
    font-size: 16px;
    color: var(--lp-ink-display);
    width: 100%;
    font-family: var(--lp-sans);
    outline: none;
    resize: vertical;
    transition: border-color 180ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .field-label input:focus,
  .field-label textarea:focus { border-bottom-color: var(--lp-ink-display); }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .submit-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin-top: 8px;
  }
  .lp-submit {
    font-family: var(--lp-sans);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--lp-paper);
    background: var(--lp-ink-display);
    border: 1px solid var(--lp-ink-display);
    border-radius: 0;
    padding: 14px 28px;
    cursor: pointer;
    transition: background 180ms cubic-bezier(0.2, 0.6, 0.2, 1), color 180ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .lp-submit:hover { background: var(--lp-paper); color: var(--lp-ink-display); }
  .lp-submit:disabled { opacity: 0.5; cursor: wait; }
  .privacy-note { max-width: 40ch; }

  .contact-sent {
    font-size: 17px;
    color: var(--lp-ink-display);
    line-height: 1.6;
    margin: 0;
  }
  .contact-fine {
    margin-top: 32px;
    max-width: 52ch;
  }
</style>
