---
interface Props {
  asTag?: 'span' | 'div';
  tone?: 'accent' | 'mute' | 'ink';
  style?: string;
  class?: string;
}
const { asTag: Tag = 'span', tone = 'accent', style = '', class: extraClass = '' } = Astro.props;
const isBlock = Tag !== 'span';
const color =
  tone === 'mute' ? 'var(--lp-mute-text)' :
  tone === 'ink'  ? 'var(--lp-ink-display)' :
                    'var(--lp-accent)';
---
<Tag
  class:list={['lp-label', isBlock && 'lp-label--block', extraClass]}
  style={`color:${color}; ${style}`}
>
  <slot />
</Tag>

<style>
  .lp-label {
    font-size: var(--lp-fs-micro);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--lp-tr-label);
    line-height: 1.4;
    white-space: nowrap;
    display: inline-block;
    margin-right: calc(var(--lp-tr-label) * -1);
  }
  .lp-label--block {
    white-space: normal;
    display: block;
  }
</style>
