---
---
<header class="site-header">
  <div class="lp-shell header-row">
    <a href="#top" aria-label="Laterna+Partners — back to top" class="logo-link">
      <img
        src="/assets/laterna-logo-mark.png"
        alt="Laterna+Partners"
        width="146"
        height="36"
      />
    </a>

    <nav class="site-nav">
      <a href="#how" class="lp-nav-link">How this works</a>
      <a href="#about" class="lp-nav-link">About</a>
      <a href="#contact" class="lp-nav-link">Get in touch</a>
    </nav>
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--lp-rule); }
  .header-row {
    padding-top: 22px;
    padding-bottom: 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .logo-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .logo-link img {
    display: block;
    height: 36px;
    width: auto;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 14px;
  }
  .lp-nav-link {
    color: var(--lp-ink);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: border-color 180ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .lp-nav-link:hover { border-bottom-color: var(--lp-rule); }
  @media (max-width: 720px) {
    .lp-nav-link { display: none; }
  }
</style>
