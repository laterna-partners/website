---
// Something to read later: the light gate on the option-agreement note.
// Sits inside the contact section, below the contact form. There is no
// always-visible download link; the link only appears after a request.
interface Props { ref?: string | null }
const { ref = null } = Astro.props;
---
<div class="note-block">
  <p class="lp-eyebrow">Something to read later</p>

  <div class="note-lead" data-reveal>
    <img
      class="lp-sketch note-cover"
      src="/assets/sketches/note-cover.webp"
      width="806"
      height="604"
      alt="An open note, six pages, with the practice's plus mark on its cover."
      loading="lazy"
    />
    <div class="note-copy">
      <h3 class="lp-h3">How option agreements actually work</h3>
      <p class="note-body">
        A short note on how an option agreement actually works: what it commits each of us to,
        and what it leaves entirely up to you. It runs to six pages and covers most of the
        questions people ask me on a first call.
      </p>
    </div>
  </div>

  <div class="note-slot">
    <form id="note-form" class="note-form" method="POST" action="/api/note-signup" novalidate>
      <div class="field-pair">
        <div class="lp-field">
          <label class="lp-label" for="note-name">
            Your name <span class="req" aria-hidden="true">*</span>
          </label>
          <input
            class="lp-input"
            id="note-name"
            name="name"
            type="text"
            placeholder="Jane Smith"
            autocomplete="name"
            required
          />
          <p class="lp-error" id="note-name-error" hidden></p>
        </div>

        <div class="lp-field">
          <label class="lp-label" for="note-email">
            Email <span class="req" aria-hidden="true">*</span>
          </label>
          <input
            class="lp-input"
            id="note-email"
            name="email"
            type="email"
            placeholder="jane@example.com"
            autocomplete="email"
            required
          />
          <p class="lp-error" id="note-email-error" hidden></p>
        </div>
      </div>

      <input
        class="honeypot"
        type="text"
        name="company"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />
      <input type="hidden" name="ref" value={ref ?? ''} />
      <input type="hidden" name="form_type" value="note-signup" />
      <input type="hidden" name="form_token" value="" />

      {ref && <p class="lp-caption">Sent with your reference {ref}</p>}

      <div class="turnstile-wrap">
        <div id="turnstile-note" class="lp-turnstile"></div>
        <p class="lp-caption">Checked for spam by Cloudflare. No cookies.</p>
      </div>

      <div class="submit-row">
        <button type="submit" class="lp-btn lp-btn-secondary">Send me the note</button>
        <p class="lp-error form-fail" id="note-fail" hidden>
          Sorry, that could not be sent. Please email
          <a href="mailto:hayri@laterna.partners" data-click="email">hayri@laterna.partners</a>
          and I will send it by hand.
        </p>
        <p class="lp-caption">Straight to your inbox. No mailing list, and I will not chase you.</p>
      </div>
    </form>

    <div id="note-success" class="note-success" role="status" hidden>
      <svg class="tick" width="24" height="24" viewBox="0 0 64 64" role="img" aria-label="Sent" focusable="false">
        <path d="M9.5 31.5L25.09 40.5L54.53 23.5" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" pathLength="1"></path>
      </svg>
      <p class="note-success-line" id="note-success-line">On its way.</p>
      <a class="note-download" id="note-download" href="#" hidden>
        Or download it now (PDF, six pages, 528 KB)
      </a>
    </div>
  </div>
</div>

<script>
  import { fillFormToken, postForm, renderTurnstile, resetTurnstile } from '../lib/form-client';

  const form = document.getElementById('note-form') as HTMLFormElement | null;
  const success = document.getElementById('note-success');
  const successLine = document.getElementById('note-success-line');
  const download = document.getElementById('note-download') as HTMLAnchorElement | null;
  const fail = document.getElementById('note-fail');
  const nameInput = document.getElementById('note-name') as HTMLInputElement | null;
  const emailInput = document.getElementById('note-email') as HTMLInputElement | null;
  const nameError = document.getElementById('note-name-error');
  const emailError = document.getElementById('note-email-error');

  const GENERIC =
    'Sorry, that could not be sent. Please email hayri@laterna.partners and I will send it by hand.';

  function setFieldError(input: HTMLInputElement | null, box: HTMLElement | null, message: string) {
    if (!input || !box) return;
    box.textContent = message;
    box.hidden = false;
    input.setAttribute('aria-invalid', 'true');
    input.setAttribute('aria-describedby', box.id);
  }

  function clearFieldError(input: HTMLInputElement | null, box: HTMLElement | null) {
    if (!input || !box) return;
    box.textContent = '';
    box.hidden = true;
    input.removeAttribute('aria-invalid');
    input.removeAttribute('aria-describedby');
  }

  function showFailure(message?: string) {
    if (!fail) return;
    if (message) fail.textContent = message;
    fail.hidden = false;
  }

  function applyServerError(code: string | undefined) {
    switch (code) {
      case 'invalid_name':
        setFieldError(nameInput, nameError, 'Please add your name so I know who to write to.');
        nameInput?.focus();
        return;
      case 'invalid_email':
      case 'invalid_contact':
      case 'note_needs_email':
        setFieldError(emailInput, emailError, 'Please check that email address.');
        emailInput?.focus();
        return;
      case 'bad_token':
      case 'verification_failed':
      case 'bad_origin':
        showFailure('That could not be checked for spam. Please try again, or email me.');
        return;
      case 'rate_limited':
        showFailure('That is several requests in a short time. Please try again shortly.');
        return;
      default:
        showFailure(GENERIC);
    }
  }

  if (form) {
    fillFormToken(form);
    renderTurnstile('turnstile-note', import.meta.env.PUBLIC_TURNSTILE_SITE_KEY);

    nameInput?.addEventListener('input', () => clearFieldError(nameInput, nameError));
    emailInput?.addEventListener('input', () => clearFieldError(emailInput, emailError));

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearFieldError(nameInput, nameError);
      clearFieldError(emailInput, emailError);
      if (fail) fail.hidden = true;

      const name = nameInput?.value.trim() ?? '';
      const email = emailInput?.value.trim() ?? '';

      if (!name) {
        setFieldError(nameInput, nameError, 'Please add your name so I know who to write to.');
        nameInput?.focus();
        return;
      }
      if (!email || !email.includes('@')) {
        setFieldError(emailInput, emailError, 'Please add the email address to send the note to.');
        emailInput?.focus();
        return;
      }

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const label = button?.textContent ?? 'Send me the note';
      if (button) {
        button.disabled = true;
        button.textContent = 'Sending...';
      }

      const tokenInput = form.querySelector<HTMLInputElement>('input[name="form_token"]');
      if (tokenInput && !tokenInput.value) await fillFormToken(form);

      try {
        const { body: result } = await postForm(form);
        if (result && result.ok) {
          if (successLine) successLine.textContent = `On its way to ${email}.`;
          const url = (result as { download_url?: string }).download_url;
          if (url && download) {
            download.href = url;
            download.hidden = false;
          }
          // Hold the space the form occupied so nothing below it moves.
          const slot = form.closest('.note-slot') as HTMLElement | null;
          if (slot) slot.style.minHeight = `${Math.round(slot.getBoundingClientRect().height)}px`;
          form.hidden = true;
          success?.removeAttribute('hidden');
          return;
        }
        applyServerError(result?.error);
      } catch {
        showFailure(GENERIC);
      }

      if (button) {
        button.disabled = false;
        button.textContent = label;
      }
      resetTurnstile('turnstile-note');
      await fillFormToken(form);
    });
  }
</script>

<style>
  .note-block {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 48px;
    border-top: 1px solid var(--lp-rule);
  }

  .note-lead { display: flex; flex-direction: column; gap: 16px; }
  .note-cover { width: 200px; max-width: 100%; height: auto; }
  .note-copy { display: flex; flex-direction: column; gap: 8px; }
  .note-body {
    font-size: 17px;
    line-height: 1.7;
    color: var(--lp-ink);
    margin: 0;
    max-width: 48ch;
    text-wrap: pretty;
  }

  /* The form's height is measured and reserved on the slot at submit time,
     so swapping in the success panel moves nothing below it. */
  .note-slot { margin-top: 16px; }
  .note-form { display: flex; flex-direction: column; gap: 24px; max-width: 62ch; }
  .note-form[hidden] { display: none; }
  .field-pair { display: flex; flex-direction: column; gap: 24px; }
  .req { color: var(--lp-ink-display); }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .turnstile-wrap { display: flex; flex-direction: column; gap: 8px; }
  .lp-turnstile { min-height: 65px; width: 100%; }
  .lp-turnstile :global(iframe) { max-width: 100%; }

  .submit-row { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .form-fail[hidden] { display: none; }

  .note-success {
    background: var(--lp-paper-soft);
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    max-width: 62ch;
  }
  .note-success[hidden] { display: none; }
  .tick { color: var(--lp-ink); }
  .tick path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: note-tick-draw 400ms cubic-bezier(0.2, 0.6, 0.2, 1) 120ms forwards;
  }
  @keyframes note-tick-draw { to { stroke-dashoffset: 0; } }
  .note-success-line {
    font-size: 17px;
    line-height: 1.6;
    color: var(--lp-ink-display);
    margin: 0;
    overflow-wrap: anywhere;
  }
  .note-download { display: inline-block; font-size: 17px; padding: 12px 0; }
  .note-download[hidden] { display: none; }

  @media (min-width: 720px) {
    .note-block { padding-top: 64px; gap: 24px; }
    .note-body { font-size: 18px; }
    .note-lead { flex-direction: row; align-items: center; gap: 32px; }
    .note-cover { flex: 0 0 160px; width: 160px; }
  }

  @media (min-width: 1024px) {
    .field-pair { flex-direction: row; gap: 24px; }
    .field-pair > .lp-field { flex: 1 1 0; min-width: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tick path { animation: none; stroke-dashoffset: 0; }
  }
</style>
