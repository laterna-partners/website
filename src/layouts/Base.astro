---
// Base layout: head, fonts, design tokens, mobile sticky-call spacing.
// Note: the page itself wraps its content in <main id="main-content">
// (see src/pages/landowners.astro); this layout must not add a second
// <main>. The skip link that targets it is added by SiteHeader, not here.
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'Laterna+Partners: a fixed-price offer for your land',
  description = 'A fixed-price offer for your land, subject to planning permission. I pay for the planning work and take the risk. You see the number before agreeing anything.',
  canonical,
} = Astro.props;

const site = Astro.site ?? 'https://laterna.partners';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).toString();
const ogImageUrl = new URL('/assets/og-image.png', site).toString();
---
<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/assets/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/Mulish-VariableFont_wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="robots" content="index, follow" />
  </head>
  <body id="top">
    <slot />
    <script>
      import { initReveal, initHeroWatch } from '../scripts/ui';

      function boot() {
        initReveal();
        initHeroWatch();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
      } else {
        boot();
      }
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/tokens.css';

  html, body { background: var(--lp-paper); }
  html { overflow-x: hidden; }
  body {
    /* Belt-and-braces guard: nothing in the layout should ever cause a
       horizontal scrollbar on mobile. If something does, it gets clipped
       rather than triggering a horizontal scroll. */
    overflow-x: hidden;
    max-width: 100vw;
  }
  /* Every direct media element gets a hard cap to avoid intrinsic-size
     overflow on narrow viewports. */
  img, svg, video { max-width: 100%; height: auto; }

  /* Legacy glue for the pre-rebuild components still present until the
     routes/upper-page/lower-page agents land their replacements. Their
     new markup uses the classes defined in tokens.css instead. */
  @media (max-width: 720px) {
    .note-form,
    .contact-form,
    .risk-grid,
    .how-grid {
      grid-template-columns: 1fr !important;
    }
    .risk-answer { font-size: clamp(56px, 18vw, 96px) !important; }
  }
</style>
